# Proposed variable contract. No application consumes this file yet.
# Never use production credentials or commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lupa
# AI queries: restricted SELECT role; must be provisioned separately.
LUPA_QUERY_DB_USERNAME=lupa_query
LUPA_QUERY_DB_PASSWORD=
# Ingestion: scoped writes; never reused for AI queries.
LUPA_INGESTION_DB_USERNAME=lupa_ingestion
LUPA_INGESTION_DB_PASSWORD=
# Flyway only: migration privileges; never reused for AI queries.
LUPA_MIGRATION_DB_USERNAME=lupa_migration
LUPA_MIGRATION_DB_PASSWORD=
PORTAL_TRANSPARENCIA_API_KEY=
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Choose and validate generation/embedding models during implementation.
LLM_MODEL=
LLM_EMBEDDING_MODEL=
OTEL_SERVICE_NAME=lupa-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Public browser configuration: never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
